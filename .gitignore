# === Large binary assets & copyrighted game data (kept local only) ===
source-mw/
archive/
content/
fsroot/gamedata/
fsroot/gamedata.old-retail-DONOTSHIP/
fsroot/*.dat
play/mwdata/

# === Dependency source caches (huge; fetched by the build) ===
deps/

# === Build directories / generated artifacts ===
build-wasm/
*.wasm
*.data
*.bsa
# Retail content files, by EXTENSION and not merely by directory: only *.bsa was listed, so an
# .esm dropped anywhere outside fsroot/gamedata or play/mwdata would have been committed.
*.esm
*.esp
*.tar
*.7z
*.zip
*.cab
*.bak
play/openmw.js
*.br

# === Credentials — never commit, regardless of location ===
*.pem
*.key
*.crt
.env
.env.*
!.env.example
!play/.env.example
*.tfstate
*.tfstate.*

# === Preserved upstream OpenMW git dir (local backup, not for this repo) ===
openmw/.git-upstream/

# === Local launcher feature-flag config (copy play/.env.example -> play/.env) ===
play/.env

# === Terraform local state & secrets (infra/) — commit .terraform.lock.hcl, not these ===
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# === OS / editor cruft ===
.DS_Store
build-wasm.good/

# Python bytecode cache (e.g. from play/server.py)
__pycache__/
*.pyc

# Multiplayer server working dirs. NOTE: do not ignore `server/` wholesale — main once
# did ("prevent accidental commit", 18a171f) from before the server was real, and a
# blanket rule now silently swallows new source files. The server source IS tracked
# (server/src, test, Dockerfile, PROTOCOL.md, …); build artifacts are handled here.
server/node_modules/
server/dist/
server/devdata/

# Phase H native sim-peer build (H1 spike): OpenMW + double-Bullet + MyGUI, macOS-local
build-native/
build-bullet-native/
build-mygui-native/
deps/native/

# Mod archives that feed the streamed asset pack (built by wasm-build/build-assetpack.py)
# are third-party downloads, never repo content (docs/LEGAL.md §7).
/wasm-build/mod-src/

# Optional performance asset pack (built by wasm-build/build-assetpack.py from
# third-party mod archives; never committed — see THIRD-PARTY-LICENSES.md).
play/moddata/

# Extracted third-party mod archives (MOP / Project Atlas sources for
# wasm-build/build-assetpack.py). Bethesda-derived meshes and textures — must
# never be committed, same rule as play/mwdata/ and fsroot/gamedata/.
wasm-build/mod-src/

# Local dev stack data (wasm-build/dev-local.sh): account/ban databases, identities,
# and config that may hold secrets.
.dev-local/
.claude/settings.local.json

# Native (non-WASM) CMake build trees — artifacts, same as build-wasm/ above.
# e.g. a native bsatool build for verifying the asset pack.
build-native/
build-*-native/

# Local databases, wherever they land. .dev-local/ already covers today's 33 files
# (accounts, bans, identities, players, tickets, attio, …), but a service writing a
# .db anywhere else must not be committable either — these hold real user records.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local deployment values (hosts, users, key paths). The SCRIPTS in ci/jenkins are
# tracked — they are part of how this project is built — but the values they read are
# one developer's own machines, and this repo is public.
ci/jenkins/config.env

# Engine logs from a local Oblivion run — build output, not source.
oblivion-play/
openmw-oblivion-wt/
# ICU data package, copied from the emsdk cache by link-openmw.sh (~28MB of upstream output).
fsroot/icu/
render-check-*.png
# Same class: local render/minimap debug captures dropped in the repo root by scenarios and
# by hand during investigation. Artifacts of looking at something, not inputs to anything.
minimap-*.png
.localbuild/

# Self-hosting stack working dirs (root docker-compose.yml). Operator data and their own
# game files: never committed, same rule as play/mwdata/ and fsroot/gamedata/.
/data/
/gamedata/
/client/
/.env
