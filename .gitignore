# === Large binary assets & copyrighted game data (kept local only) ===
source-mw/
archive/
content/
fsroot/gamedata/
fsroot/gamedata.old-retail-DONOTSHIP/
fsroot/*.dat
play/mwdata/

# === Dependency source caches (huge; fetched by the build) ===
deps/

# === Build directories / generated artifacts ===
build-wasm/
*.wasm
*.data
*.bsa
*.tar
*.7z
*.zip
*.cab
*.bak
play/openmw.js
*.br

# === Credentials — never commit, regardless of location ===
*.pem
*.key
*.crt
.env
.env.*
!.env.example
!play/.env.example
*.tfstate
*.tfstate.*

# === Preserved upstream OpenMW git dir (local backup, not for this repo) ===
openmw/.git-upstream/

# === Local launcher feature-flag config (copy play/.env.example -> play/.env) ===
play/.env

# === Terraform local state & secrets (infra/) — commit .terraform.lock.hcl, not these ===
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# === OS / editor cruft ===
.DS_Store
build-wasm.good/

# Python bytecode cache (e.g. from play/server.py)
__pycache__/
*.pyc

# Local multiplayer server (Node; not part of the web client)
server/

# Optional performance asset pack (built by wasm-build/build-assetpack.py from
# third-party mod archives; never committed — see THIRD-PARTY-LICENSES.md).
play/moddata/
