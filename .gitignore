# === Large binary assets & copyrighted game data (kept local only) ===
source-mw/
archive/
content/
fsroot/gamedata/
fsroot/gamedata.old-retail-DONOTSHIP/
fsroot/*.dat
play/mwdata/

# === Dependency source caches (huge; fetched by the build) ===
deps/

# === Build directories / generated artifacts ===
build-wasm/
*.wasm
*.data
*.bsa
*.tar
*.7z
*.zip
*.cab
*.bak
play/openmw.js
*.br

# === Credentials — never commit, regardless of location ===
*.pem
*.key
*.crt
.env
.env.*
!.env.example
!play/.env.example
*.tfstate
*.tfstate.*

# === Preserved upstream OpenMW git dir (local backup, not for this repo) ===
openmw/.git-upstream/

# === Local launcher feature-flag config (copy play/.env.example -> play/.env) ===
play/.env

# === Terraform local state & secrets (infra/) — commit .terraform.lock.hcl, not these ===
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example

# === OS / editor cruft ===
.DS_Store
build-wasm.good/

# Python bytecode cache (e.g. from play/server.py)
__pycache__/
*.pyc

# Local multiplayer server (Node; not part of the web client)
server/

# Optional performance asset pack (built by wasm-build/build-assetpack.py from
# third-party mod archives; never committed — see THIRD-PARTY-LICENSES.md).
play/moddata/

# Extracted third-party mod archives (MOP / Project Atlas sources for
# wasm-build/build-assetpack.py). Bethesda-derived meshes and textures — must
# never be committed, same rule as play/mwdata/ and fsroot/gamedata/.
wasm-build/mod-src/

# Local dev state that is not part of this project: account/ban databases,
# identities, and config that may hold secrets.
.dev-local/

# Native (non-WASM) CMake build trees — artifacts, same as build-wasm/ above.
# e.g. a native bsatool build for verifying the asset pack.
build-native/
build-*-native/

# Local databases, wherever they land. .dev-local/ already covers today's 33 files
# (accounts, bans, identities, players, tickets, attio, …), but a service writing a
# .db anywhere else must not be committable either — these hold real user records.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Local-only working notes and CI. AGENTS.md documents this developer's own build/test
# servers; ci/jenkins runs on that local Jenkins, not on the public GitHub runners
# (.github/workflows/ is the public CI).
AGENTS.md
ci/
