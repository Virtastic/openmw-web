# Copy to play/.env to override defaults. Nothing here is required.
#
# The site root ("/") serves launcher.html by default — where visitors pick between the
# bundled OpenMW sample game and their own local Morrowind files. This matches the deployed
# site. Set to 0 to skip the chooser and boot straight into the game at "/".
# OPENMW_LAUNCHER=0

# Override the dev-server port (default 8910).
# PORT=8910
