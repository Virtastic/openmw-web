# OpenMW-Web multiplayer client (omw-mp/1, M0). Not part of the default content chain:
# play/index.html appends `content=mp.omwscripts` only when the ?mp= query param is present,
# so singleplayer is completely unaffected.
GLOBAL: scripts/mp/global.lua
PLAYER: scripts/mp/player.lua
# Phase C social window (F). Separate from player.lua so the friends UI and the chat UI
# cannot break each other, and so the file stays reviewable.
PLAYER: scripts/mp/social.lua
# Phase E3 admin window (G). Menu is built from the server's own /help reply.
MENU: scripts/mp/menu.lua
# COMPANIONS. On the ACTOR, not in the holder's diff loop, because a global script cannot read
# AI package state for a foreign actor -- an engine limitation, and the reason ActorAI sat as
# dead protocol surface. An actor's own script can read its own packages. Silent unless the
# answer changes, which for an ordinary NPC is never.
NPC: scripts/mp/companion.lua
CREATURE: scripts/mp/companion.lua
CUSTOM: scripts/mp/puppet.lua
# Phase 3: the input-driven body on the SIM PEER only (global.lua attaches it when
# mp.isSystem()); everywhere else the same body gets puppet.lua instead.
CUSTOM: scripts/mp/avatar.lua
# Test-only: attached on demand by actors.killActorByRecord (see testkill.lua).
CUSTOM: scripts/mp/testkill.lua
