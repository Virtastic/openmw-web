# Copy to ci/jenkins/config.env and fill in for YOUR infrastructure. That file is gitignored:
# this repo is public, so no host, user or key path belongs in git.
#
#   cp ci/jenkins/config.env.example ci/jenkins/config.env && $EDITOR ci/jenkins/config.env
#
# Every value can also be supplied as an environment variable instead, which is what a CI job
# should do. The precedence is: environment > config.env > the defaults below (which are
# deliberately placeholders that fail loudly rather than pointing at somebody else's machine).

# --- build server ------------------------------------------------------------------------
# Anything ssh(1) can reach: a Host alias from ~/.ssh/config, or user@host.
BUILDER="builder.example"
# Path on the build server holding the synced working tree.
DEST="morrowind-src"

# --- test/app server ---------------------------------------------------------------------
# Where deploy-test.sh ships images. user@host, or an ssh alias.
TEST_HOST="deploy@app.example"
# Key the BUILD SERVER uses to reach the test server. In a Jenkins container this is usually
# /var/jenkins_home/.ssh/id_ed25519; running the script by hand it is your own key.
SSH_KEY="$HOME/.ssh/id_ed25519"

# --- the deployed origin -------------------------------------------------------------------
# Public URL the smoke test runs against after a deploy. Half the serving contract (TLS, the
# edge forwarding X-Forwarded-Proto, the launcher gate) only exists at the real origin, so
# pointing this at localhost proves very little. Set empty to skip the gate — not advised.
SMOKE_URL="https://play.example"

# Docker network shared by the engine and gateway containers. The default bridge has no DNS,
# so the engine's Caddy could not resolve the gateway by name without a user-defined network.
NETWORK="omw-test"
