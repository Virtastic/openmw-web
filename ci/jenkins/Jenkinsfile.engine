// Pipeline for the OpenMW-Web-Engine-WASM job. Lives in the REPO, not in Jenkins own config,
// so it is versioned, reviewable through a PR against dev, and survives the Jenkins container
// being rebuilt. It is also what lets polling work AT ALL: a pipeline whose script is inline in
// the job has no SCM until it has run once, so pollSCM has nothing to poll and the job can only
// ever be started by hand. Script-from-SCM gives Jenkins the SCM from the job config itself.
pipeline {
  agent any
  options { timestamps(); timeout(time: 60, unit: 'MINUTES'); disableConcurrentBuilds() }
  stages {
    stage('Checkout dev') {
      steps {
        // Build in /src, not the Jenkins workspace: /src is the host's ~/morrowind-src, and it
        // is where the ~750 MB of gitignored build inputs live between builds.
        dir('/src') {
          checkout([$class: 'GitSCM',
                    branches: [[name: '*/dev']],
                    userRemoteConfigs: [[url: 'https://github.com/Virtastic/openmw-web.git']]])
        }
        // `cd /src` rather than another dir('/src'): a `sh` step inside dir(X) makes Jenkins
        // create a sibling X@tmp, and /src is a MOUNT, so that sibling would have to be created
        // at the container's root -- which is owned by root while Jenkins runs as uid 1000.
        // Build 46 died on exactly that (AccessDeniedException: /src@tmp) after the container
        // was rebuilt. checkout() alone needs no @tmp, so only the sh has to move out.
        sh 'cd /src && git rev-parse HEAD > .source-commit && echo "building $(git log --oneline -1)"'
      }
    }
    stage('Restage build inputs') { steps { sh '/src/ci/jenkins/restage-inputs.sh' } }
    stage('Compile OpenMW to WebAssembly')               { steps { sh '/src/ci/jenkins/build-engine.sh' } }
    // Unconditional on purpose: an image that was never deployed has never been tested.
    // deploy-test.sh runs the contract gate itself and fails the build on any miss.
    stage('Deploy to test server') { steps { sh '/src/ci/jenkins/deploy-test.sh engine' } }
  }
}
