{
  "name": "openmw-mp",
  "version": "1.7.26",
  "private": true,
  "type": "module",
  "description": "Relay/validator/persister server for openmw-web multiplayer (omw-mp/1, M0)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node esbuild.mjs",
    "test": "tsc --noEmit && node --import tsx --test --test-concurrency=2 test/*.test.ts",
    "start": "node dist/server.mjs",
    "lser-dump": "tsx src/proto/lser-dump.ts",
    "docs:admin": "tsx test/admin-commands-doc.ts",
    "soak": "tsx bots/soak.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "smol-toml": "^1.9.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
