#
# Linux native build of the Phase H simulation peer: OpenMW (our fork, with OPENMW_HEADLESS
# and the mwmp transport) built with rendering disabled, for the tier-2 deploy target.
#
# An upstream OpenMW binary CANNOT be used — it has neither OPENMW_HEADLESS nor our mwmp
# WebSocket transport, both of which are fork-local additions. So we build the fork.
#
# Linux is the easy platform for this: unlike macOS/brew, every dependency but one is
# apt-installable. The exception is Bullet, which OpenMW wants in DOUBLE precision
# (BulletConfig-float64.cmake) and Ubuntu ships single, so it is built from source here.
#
#   docker build -f server/Dockerfile.simpeer -t openmw-simpeer .
# The result carries /usr/local/bin/openmw + its resources; run with OPENMW_HEADLESS=1.

FROM ubuntu:24.04 AS build
ENV DEBIAN_FRONTEND=noninteractive

# Toolchain + every OpenMW dependency that Ubuntu packages directly.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ca-certificates pkg-config \
      libopenscenegraph-dev libsdl2-dev libopenal-dev \
      libavcodec-dev libavformat-dev libavutil-dev libswscale-dev libswresample-dev \
      libboost-filesystem-dev libboost-program-options-dev libboost-system-dev libboost-iostreams-dev \
      libbz2-dev liblz4-dev libz-dev \
      libluajit-5.1-dev librecast-dev libsqlite3-dev \
      libfreetype-dev libtinyxml-dev libyaml-cpp-dev libicu-dev \
    && rm -rf /var/lib/apt/lists/*

# MyGUI 3.4.3 from source: Ubuntu 24.04 ships 3.4.2 and OpenMW requires >= 3.4.3. Built with
# MYGUI_DONT_USE_OBSOLETE=ON — without it the OpenMW link fails on `non-virtual thunk` symbols,
# the exact wall the macOS build hit. Platform/demos/tools off; only the engine lib is needed.
RUN git clone --depth 1 --branch MyGUI3.4.3 https://github.com/MyGUI/mygui.git /tmp/mygui \
    && cmake -S /tmp/mygui -B /tmp/mygui/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DMYGUI_DONT_USE_OBSOLETE=ON -DMYGUI_RENDERSYSTEM=1 \
        -DMYGUI_BUILD_DEMOS=OFF -DMYGUI_BUILD_TOOLS=OFF -DMYGUI_BUILD_PLUGINS=OFF \
        -DMYGUI_BUILD_UNITTESTS=OFF -DMYGUI_BUILD_TEST_APP=OFF \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/mygui/build --target install \
    && rm -rf /tmp/mygui

# Double-precision Bullet from source — Ubuntu's libbullet-dev is single precision and
# OpenMW's physics wants float64. Pinned to the same 3.x line the macOS peer used.
RUN git clone --depth 1 --branch 3.25 https://github.com/bulletphysics/bullet3.git /tmp/bullet \
    && cmake -S /tmp/bullet -B /tmp/bullet/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DUSE_DOUBLE_PRECISION=ON -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_BULLET2_DEMOS=OFF -DBUILD_CPU_DEMOS=OFF -DBUILD_EXTRAS=OFF \
        -DBUILD_UNIT_TESTS=OFF -DINSTALL_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/bullet/build --target install \
    && rm -rf /tmp/bullet

# The engine source. Everything under openmw/ is the fork; the mp additions live in
# apps/openmw/mwmp and the headless guards in apps/openmw/engine.cpp.
COPY openmw /src/openmw

# HOW MANY COMPILES AT ONCE, and why this is not left to ninja.
#
# Ninja defaults to nproc+2. On a 32-core / 16 GB machine that is 34 concurrent g++ processes
# on OpenMW translation units that individually reach 1-2 GB — the box goes to swap, the Docker
# daemon stops answering, and the build sits at the same object file indefinitely with no error
# and no output. Measured doing exactly that at [652/859].
#
# It presents as a hang rather than an OOM kill, which is the worst kind: nothing fails, so
# there is nothing to read. Budget roughly 1 GB of RAM per job and set BUILD_JOBS accordingly;
# the default is deliberately conservative so the image builds on an ordinary machine rather
# than only on the one it was written on.
ARG BUILD_JOBS=6
ENV CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}

# Tools OFF (no launcher/wizard/opencs): the peer never renders a menu, and turning them off
# also avoids the Qt dependency. The APPLE-only bundling guard added for the macOS build does
# not apply here.
RUN cmake -S /src/openmw -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DBUILD_OPENMW=ON -DBUILD_LAUNCHER=OFF -DBUILD_WIZARD=OFF -DBUILD_OPENCS=OFF \
      -DBUILD_BSATOOL=OFF -DBUILD_ESMTOOL=OFF -DBUILD_NIFTEST=OFF -DBUILD_BULLETOBJECTTOOL=OFF \
      -DBUILD_ESSIMPORTER=OFF -DBUILD_MWINIIMPORTER=OFF -DBUILD_NAVMESHTOOL=OFF \
      -DUSE_QT=OFF -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    && cmake --build /build --target openmw
# No `cmake --install`: OpenMW's install rules scatter (configs land, binary/resources do not
# — verified: the first runtime build failed on it). The runtime stage copies straight from
# the build tree instead, which is unambiguous.

# Runtime image: the binary, its resources, and the shared libs it links. No game data —
# that is bring-your-own at the mount, exactly as documented in SELF_HOSTING.md.
FROM ubuntu:24.04 AS runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      libopenscenegraph161 libsdl2-2.0-0 libopenal1 \
      libavcodec60 libavformat60 libavutil58 libswscale7 libswresample4 \
      libluajit-5.1-2 librecast1 libsqlite3-0 libyaml-cpp0.8 libicu74 liblz4-1 \
      libboost-program-options1.83.0 \
      libegl1 libgl1 libgles2 libegl-mesa0 libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /build/openmw /usr/local/bin/openmw
# Engine resources (vfs, shaders, builtin.omwscripts, ...). The generated peer cfg points its
# `resources=` line here.
COPY --from=build /build/resources /usr/local/share/openmw/resources
# The engine refuses to boot without defaults.bin in the global config dir (fatal, verified);
# gamecontrollerdb.txt lives beside it.
COPY --from=build /build/defaults.bin /build/gamecontrollerdb.txt /usr/local/etc/openmw/
# The build tree's openmw.cfg is load-bearing, not boilerplate: it chains the user config dir
# (`config="?userconfig?"` — without it `--config <dir>` is silently ignored and the engine
# aborts with "No content file given", verified) and carries every `fallback=` GMST the
# simulation reads (lighting, water, combat constants). Ship it as the global config with its
# build-tree-relative paths rewritten.
COPY --from=build /build/openmw.cfg /usr/local/etc/openmw/openmw.cfg
RUN sed -i 's|=\./resources|=/usr/local/share/openmw/resources|' /usr/local/etc/openmw/openmw.cfg
# Bullet is linked statically, but MyGUI (built from source — no Ubuntu package is new
# enough) is a shared lib and must ride along.
COPY --from=build /usr/local/lib/libMyGUIEngine.so* /usr/local/lib/
RUN ldconfig
# SDL offscreen driver: a displayless box has no X11, so the hidden window from the macOS
# path is replaced by SDL's offscreen video backend. Proven only by SDL docs so far.
ENV SDL_VIDEODRIVER=offscreen
ENTRYPOINT ["openmw"]

# ---------------------------------------------------------------------------------------
# tier2: the node server AND the peer binary in one image. The SimPeerSupervisor spawns
# the peer via child_process, so for server-authoritative NPCs in production both must
# live in the same container — and the standard server image (node:22-alpine, musl)
# cannot run this glibc binary, hence a glibc-based variant here rather than a change
# to server/Dockerfile. Tier 1 deploys keep using the alpine image; this one is only
# worth its ~1GB when the operator mounts game data.
#   docker build -f server/Dockerfile.simpeer --target tier2 -t openmw-mp:tier2 .

FROM node:22-bookworm-slim AS server-build
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci
COPY server/tsconfig.json server/esbuild.mjs ./
COPY server/src ./src
COPY server/test ./test
COPY server/config.default.toml ./
RUN npm run build && npm test

FROM runtime AS tier2
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates wget \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production
COPY server/package.json server/package-lock.json ./
# Reinstalled here rather than copied: @node-rs/argon2 is a native module and the alpine
# (musl) artifact would not load on glibc.
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=server-build /app/dist ./dist
COPY server/config.default.toml ./
RUN useradd -m app && mkdir -p /data && chown app /data
USER app
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
# The sim peer is mandatory since 1.1.0: the server probes `openmw` on PATH
# (/usr/local/bin) and refuses to boot unless the operator mounted valid game data at
# /data/gamedata. Same heap-cap reasoning as the alpine image.
ENTRYPOINT []
CMD ["node", "--max-old-space-size=512", "dist/gateway.mjs", "--worlds", "/data/worlds", "--shared", "/data", "--port", "8080", "--base-port", "9000"]
